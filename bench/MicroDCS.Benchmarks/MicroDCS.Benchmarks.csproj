<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>BenchmarkDotNet benchmarks of the envelope codec and the pipeline hot path (R-18). Run with: dotnet run -c Release --project bench/MicroDCS.Benchmarks.</Description>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroDCS.Core/MicroDCS.Core.csproj" />
    <ProjectReference Include="../../src/MicroDCS.Generators/MicroDCS.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
