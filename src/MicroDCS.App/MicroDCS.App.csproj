<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>MicroDCS application host: the Native AOT smoke checks and the greetings demo processor until the transports arrive.</Description>
    <OutputType>Exe</OutputType>
    <AssemblyName>microdcs</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Native AOT; RuntimeIdentifiers come from Directory.Build.props. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      One warning per assembly instead of one per call site. CloudNative.CloudEvents* is not
      annotated for trimming yet (upstream PR #381, D-14), so it produces IL2104/IL3053 once per
      assembly. They are not errors here; scripts/check-aot-warnings fails the publish on every
      other trim or AOT warning, including IL2104/IL3053 from any other assembly.
    -->
    <TrimmerSingleWarn>true</TrimmerSingleWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MicroDCS.Core/MicroDCS.Core.csproj" />
    <ProjectReference Include="../MicroDCS.Inspection/MicroDCS.Inspection.csproj" />
    <ProjectReference Include="../MicroDCS.Maintenance/MicroDCS.Maintenance.csproj" />
    <ProjectReference Include="../MicroDCS.Mcp/MicroDCS.Mcp.csproj" />
    <ProjectReference Include="../MicroDCS.Transport.Mqtt/MicroDCS.Transport.Mqtt.csproj" />
    <ProjectReference Include="../MicroDCS.Transport.Nats/MicroDCS.Transport.Nats.csproj" />
    <ProjectReference Include="../MicroDCS.Valkey/MicroDCS.Valkey.csproj" />
    <ProjectReference Include="../MicroDCS.Generators/MicroDCS.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CloudNative.CloudEvents" />
    <PackageReference Include="CloudNative.CloudEvents.SystemTextJson" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
