<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>MicroDCS SFC host over Valkey: work stream, atomic step, push command dispatch, deadline sweep, inspection (S19).</Description>
    <!-- Source-generated configuration binding: no reflection, AOT safe (D-39). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MicroDCS.Core/MicroDCS.Core.csproj" />
    <ProjectReference Include="../MicroDCS.MachineryJobs/MicroDCS.MachineryJobs.csproj" />
    <ProjectReference Include="../MicroDCS.Sfc/MicroDCS.Sfc.csproj" />
    <ProjectReference Include="../MicroDCS.Valkey/MicroDCS.Valkey.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MicroDCS.Sfc.Hosting.Tests" />
    <InternalsVisibleTo Include="MicroDCS.IntegrationTests" />
  </ItemGroup>
</Project>
