<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>MicroDCS maintenance operations: plan and apply with snapshots and restore over the Valkey state (D-19, D-45). Dev and test only; production applications do not reference it.</Description>
    <!-- Source-generated configuration binding: no reflection, AOT safe (D-39). -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MicroDCS.Core/MicroDCS.Core.csproj" />
    <ProjectReference Include="../MicroDCS.Sfc/MicroDCS.Sfc.csproj" />
    <ProjectReference Include="../MicroDCS.Valkey/MicroDCS.Valkey.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
</Project>
