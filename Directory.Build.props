<Project>
  <!-- Shared settings for every project. Project-specific settings stay in the .csproj. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <!-- Project directory relative to the repository root, for the src/ and tests/ groups below.
         Relative on purpose: an absolute path such as /src/tests/... (container build) must not match. -->
    <_RepoRelativeProjectDir>$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\', '/'))/</_RepoRelativeProjectDir>

    <!-- Zero warnings: every warning fails the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Reproducible builds. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Restore: lock files everywhere, locked mode in CI, NuGet audit of all packages. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- Package metadata. -->
    <Authors>Andreas Schamberger</Authors>
    <Copyright>Copyright (c) 2026 Andreas Schamberger</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://aschamberger.github.io/microdcs/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aschamberger/microdcs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Library projects under src/: AOT compatible (enables the trim, AOT and single-file analyzers) and XML docs. -->
  <PropertyGroup Condition="$(_RepoRelativeProjectDir.StartsWith('src/'))">
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Publish targets of the container images. Restoring them keeps every lock file valid for
         `dotnet publish -r <rid>` in locked mode (a RID publish restores referenced projects too). -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Test projects under tests/: not packable, no XML docs required. -->
  <PropertyGroup Condition="$(_RepoRelativeProjectDir.StartsWith('tests/'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <!-- Code coverage extension for Microsoft.Testing.Platform (coverage switch of `dotnet test`), read by SonarQube Cloud (D-20). -->
  <ItemGroup Condition="$(_RepoRelativeProjectDir.StartsWith('tests/'))">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
</Project>
