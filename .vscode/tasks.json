{
  // See https://go.microsoft.com/fwlink/?LinkId=733558 for the tasks.json format.
  "version": "2.0.0",
  "presentation": {
    "reveal": "always",
    "panel": "dedicated"
  },
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet build MicroDCS.slnx",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "dotnet test --solution MicroDCS.slnx",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "format",
      "type": "shell",
      "command": "dotnet format MicroDCS.slnx",
      "problemMatcher": []
    },
    {
      "label": "format (verify)",
      "type": "shell",
      "command": "dotnet format MicroDCS.slnx --verify-no-changes",
      "problemMatcher": []
    },
    {
      "label": "dev stack up (MQTT, Valkey, Aspire dashboard)",
      "type": "shell",
      "command": "docker compose up -d --wait",
      "problemMatcher": []
    },
    {
      "label": "dev stack down",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "docs serve",
      "type": "shell",
      "command": "python3 -m venv .venv-docs && .venv-docs/bin/pip install --require-hashes -r docs/requirements.txt && .venv-docs/bin/zensical serve",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "App deployment",
      "type": "shell",
      "command": "kubectl apply -f ./deploy/k8s.yaml",
      "options": {
        "env": { "KUBECONFIG": "${userHome}${/}.kube${/}config.yaml" }
      },
      "problemMatcher": []
    }
  ]
}
