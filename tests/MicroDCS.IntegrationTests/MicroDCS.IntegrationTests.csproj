<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Integration tests. They run inside the compose harness (compose.test.yaml, D-15), which sets the
    MICRODCS_TEST_* endpoints. Without them (plain `dotnet test` on the host) every test is skipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroDCS.Valkey/MicroDCS.Valkey.csproj" />
    <ProjectReference Include="../../src/MicroDCS.Maintenance/MicroDCS.Maintenance.csproj" />
    <ProjectReference Include="../../src/MicroDCS.Transport.Mqtt/MicroDCS.Transport.Mqtt.csproj" />
    <ProjectReference Include="../../src/MicroDCS.Transport.Nats/MicroDCS.Transport.Nats.csproj" />
    <ProjectReference Include="../../src/MicroDCS.App/MicroDCS.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
