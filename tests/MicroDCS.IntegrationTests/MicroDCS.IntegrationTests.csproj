<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Integration tests. They run inside the compose harness (compose.test.yaml, D-15), which sets the
    MICRODCS_TEST_* endpoints. Without them (plain `dotnet test` on the host) every test is skipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MicroDCS.Valkey/MicroDCS.Valkey.csproj" />
    <ProjectReference Include="../../src/MicroDCS.MachineryJobs/MicroDCS.MachineryJobs.csproj" />
    <ProjectReference Include="../../src/MicroDCS.Maintenance/MicroDCS.Maintenance.csproj" />
    <ProjectReference Include="../../src/MicroDCS.Transport.Mqtt/MicroDCS.Transport.Mqtt.csproj" />
    <ProjectReference Include="../../src/MicroDCS.Transport.Nats/MicroDCS.Transport.Nats.csproj" />
    <ProjectReference Include="../../src/MicroDCS.App/MicroDCS.App.csproj" />
    <ProjectReference Include="../../src/MicroDCS.Sfc.Hosting/MicroDCS.Sfc.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <!-- The island ACL rule (docs/deployment.md#tenancy); the Valkey tests run the production code as that user. -->
    <None Include="../../deploy/valkey-island-acl.conf" Link="valkey-island-acl.conf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
