#!/usr/bin/env bash
# SFC replica tests (S20, D-53): two instances of the application image, killed from outside.
# Not part of the main compose run, because a container that exits ends
# `--abort-on-container-exit`. Results land in TestResults/replica.
#
#   scripts/replica-tests
set -euo pipefail
cd "$(dirname "$0")/.."

compose=(docker compose -f compose.test.yaml --profile replicas)
mkdir -p TestResults/replica

cleanup() {
  "${compose[@]}" logs --no-color --timestamps > TestResults/replica/services.log 2>&1 || true
  "${compose[@]}" down -v
}
trap cleanup EXIT

"${compose[@]}" build sfc-a replica-tests
"${compose[@]}" up -d --wait valkey mosquitto
"${compose[@]}" up -d --no-build sfc-a sfc-b
"${compose[@]}" run --rm replica-tests
cat TestResults/replica/sweep-latency.txt
